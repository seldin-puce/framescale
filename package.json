{
  "name": "framescale",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @framescale/desktop tauri dev",
    "build": "pnpm --filter @framescale/desktop tauri build",
    "ui:dev": "pnpm --filter @framescale/desktop dev",
    "ui:build": "pnpm --filter @framescale/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "gen:types": "cargo xtask gen-types",
    "setup": "cargo xtask setup"
  }
}
