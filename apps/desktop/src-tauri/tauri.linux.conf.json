{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libvulkan1"
        ],
        "section": "video",
        "desktopTemplate": "./linux.desktop"
      },
      "rpm": {
        "depends": [
          "vulkan-loader"
        ],
        "desktopTemplate": "./linux.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
